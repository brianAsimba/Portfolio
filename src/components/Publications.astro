---
import { getCollection } from 'astro:content';

const publications = await getCollection('publications');
---

<section id="publications" class="section section-alt">
  <div class="container">
    <p class="section-eyebrow">04 — Publications</p>
    <h2 class="section-title">Published research</h2>
    <div class="pub-list">
      {publications.map((pub) => (
        <article class="pub-card">
          <p class="pub-venue">{pub.data.venue} · {pub.data.year}</p>
          <h3>{pub.data.title}</h3>
          <p class="pub-authors">{pub.data.authors}</p>
          <p class="pub-summary">{pub.data.summary}</p>
          {pub.data.url && (
            <a class="pub-link" href={pub.data.url} target="_blank" rel="noopener">View paper ↗</a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
