<section id="contact" class="section section-alt">
  <div class="container contact-inner">
    <p class="section-eyebrow">08 — Contact</p>
    <h2 class="section-title">Get in touch</h2>
    <p class="contact-sub">Have a role, a project, or just want to talk AI, manufacturing, or stamping engineering? Send a message below.</p>

    <form class="contact-form" action="https://formspree.io/f/briano377@gmail.com" method="POST">
      <input type="hidden" name="_subject" value="Contact request from personal website" />
      <div class="form-row">
        <input type="email" name="_replyto" placeholder="Your email" required />
      </div>
      <div class="form-row">
        <textarea name="message" placeholder="Your message" rows="5" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Send</button>
    </form>
  </div>
</section>
